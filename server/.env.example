# ---------------------------------------------------------------------------
# Hubtel credentials — from the Hubtel dashboard, API Keys section.
# Leave HUBTEL_MODE=mock to run the whole service without credentials.
# ---------------------------------------------------------------------------
HUBTEL_MODE=mock                     # mock | live
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=             # "Merchant Account Number" / POS Sales ID

# Public base URL Hubtel can reach for callbacks. In development use a tunnel
# (ngrok/cloudflared) — Hubtel cannot POST to localhost.
PUBLIC_BASE_URL=http://localhost:8787

# Hubtel callbacks are not HMAC-signed, so the callback path carries an
# unguessable secret AND every callback is re-verified against the status API.
# Generate with: openssl rand -hex 24
WEBHOOK_PATH_SECRET=dev-only-change-me

PORT=8787

# Commission retained by Ryde, in basis points (2000 = 20%).
COMMISSION_BP=2000

# Riders may owe at most this much before new trip requests are blocked (pesewas).
MAX_RIDER_DEBT_PESEWAS=5000

# Ops endpoints (/api/ops/*) use this, never a user session.
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=change-me

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5178

# Set true only when behind a proxy that strips inbound X-Forwarded-For.
TRUST_PROXY=false

# Registered Hubtel sender ID for OTP messages.
SMS_SENDER_ID=Ryde

# Development shim: auto-assign a driver at quote time so a single-device demo
# can complete a trip. Real dispatch is the driver accepting in the driver app.
# Ignored when HUBTEL_MODE=live. Leave false for anything resembling production.
DEMO_AUTO_ASSIGN=false
